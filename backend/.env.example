# Required for API startup. Put real secrets in .env only.
YOUTUBE_API_KEY=
GEMINI_API_KEY=
SAVE_TOKEN_SECRET=
FIREBASE_PROJECT_ID=
EXTRACT_API_KEY=

HOST=127.0.0.1
PORT=3000
LIBRARY_DB_PATH=data/library.db
CACHE_DIR=cache
MAX_VIDEO_SECONDS=300
VIDEO_UPLOAD_MAX_MB=100

# PostgreSQL copy for POST /api/extract. Off by default.
PG_WRITE_ENABLED=0
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SSL=0

# Optional TikTok readers, if these programs are installed.
TIKTOK_YTDLP=0
TIKTOK_GALLERYDL=0
TIKTOK_COVER_SAVE=0

# Optional Facebook provider. Meta access tokens are separate and are not used here.
APIFY_TOKEN=
# Bounded media fallbacks; enabled for Facebook when the executables are installed.
FACEBOOK_YTDLP_PATH=yt-dlp
FACEBOOK_GALLERYDL_PATH=gallery-dl
